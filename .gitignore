# Agent configs that contributors might run against this repo locally:
# don't pollute the repo with one author's tool setup.
CLAUDE.md
/.cursor/
/.claude/

# Block .github/ contents EXCEPT the CI workflows that ship with the repo.
/.github/*
!/.github/workflows/

# v1-era work-items-private/ guard.
# Pre-v2 setups used this folder for gitignored private work items, sometimes
# as a symlink/junction to a cloud-synced location. v2 moved private items
# to a configured work_items_path outside the repo, so a fresh v2 install
# won't have this folder at all. The lines below remain as a safety net so
# any contributor with leftover v1 data doesn't accidentally publish it.
change/work-items-private/
change/work-items-private

# The test dependency.
node_modules/

# Python bytecode, from the skills that ship Python
__pycache__/
*.pyc

# Clones made by bin/skills.mjs
.agents/.skill-sources/
